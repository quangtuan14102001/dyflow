# ==== dyflow web app ====
# Copy file nay thanh .env va dien gia tri that.

# Telegram bot (neu dung bot render video + xac minh trial)
TELEGRAM_BOT_TOKEN=

# Channel public de trial (bot phai la admin channel)
TELEGRAM_CHANNEL=@dyflow_app
# Optional: username bot (neu trong se tu getMe)
# TELEGRAM_BOT_USERNAME=

# Chat ID admin nhan thong bao khi user nap crypto
# Cach lay: 1) chat /start voi bot  2) mo:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# Tim "chat":{"id": 123456789 }
TELEGRAM_ADMIN_CHAT_ID=

# So luong job chay song song (ghi de config web.workers)
DYFLOW_WEB_WORKERS=1

# Dat =1 neu chay worker o tien trinh RIENG (khong chay kem web)
# DYFLOW_WEB_NO_WORKER=1

# ==== Nap crypto bang tay (khong dung cong ben thu 3) ====
CRYPTO_WALLET_ADDRESS=
CRYPTO_NETWORK=TRC20
CRYPTO_ASSET=USDT

# Email admin (duoc duyet don nap tai /admin/payments)
ADMIN_EMAIL=

# ==== SMTP bat buoc de gui email reset mat khau ====
# Vi du Gmail: bat 2FA -> tao App Password, dung lam SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# Link trong email reset (phai la URL cong khai neu user click tu mail)
PUBLIC_BASE_URL=http://localhost:8080
