# ==== dyflow web app ====
# Copy file nay thanh .env va dien gia tri that.

# Telegram bot (neu dung bot render video + xac minh trial)
TELEGRAM_BOT_TOKEN=

# Channel public de trial (bot phai la admin channel)
TELEGRAM_CHANNEL=@dyflow_app
# Optional: username bot (neu trong se tu getMe)
# TELEGRAM_BOT_USERNAME=

# Chat ID admin nhan thong bao khi user nap crypto
# Cach lay: 1) chat /start voi bot  2) mo:
#   https://api.telegram.org/bot<TOKEN>/getUpdates
# Tim "chat":{"id": 123456789 }
TELEGRAM_ADMIN_CHAT_ID=

# So job may nay chay song song (ghi de config web.workers).
# 100 user song song can tong workers tren moi may >= so job dang chay.
DYFLOW_WEB_WORKERS=64

# Toi da job running dong thoi MOI user (mac dinh 2)
DYFLOW_MAX_CONCURRENT_PER_USER=2

# Dat =1 neu chay worker o tien trinh RIENG (khong chay kem web)
# DYFLOW_WEB_NO_WORKER=1

# ==== Nap crypto bang tay (khong dung cong ben thu 3) ====
CRYPTO_WALLET_ADDRESS=
CRYPTO_NETWORK=TRC20
CRYPTO_ASSET=USDT

# Email admin web (super admin + duyet nap + free video)
ADMIN_EMAIL=

# Telegram ID ca nhan cua SUPER admin (so duong). Lay bang /myid voi bot.
# Chi ID nay duoc /admin_add /admin_remove /credit tren bot.
TELEGRAM_SUPER_ADMIN_ID=

# Chat nhan thong bao nap (group hoac private). Chi gui toi day, khong spam user.
TELEGRAM_ADMIN_CHAT_ID=

# ==== SMTP bat buoc de gui email reset mat khau ====
# Vi du Gmail: bat 2FA -> tao App Password, dung lam SMTP_PASSWORD
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TLS=1

# Link trong email reset (phai la URL cong khai neu user click tu mail)
PUBLIC_BASE_URL=http://localhost:8080

# TTS + viet lai ban dich (web). Dien key that — de trong se bi file .env.example che.
# Pre-flight chi fail khi KHONG tim thay key o bat ky .env nao (source / VideosCreator).
# DYFLOW_ENV=dev
OPENAI_API_KEY=
# Optional: model chat de dich / rut loi (mac dinh gpt-4o-mini — re).
# Chi set gpt-4o neu can chat luong toi da (dat hon nhieu).
# OPENAI_TRANSLATE_MODEL=gpt-4o-mini
# OPENAI_REVIEW_MODEL=gpt-4o-mini
# DeepSeek dich (API tuong thich OpenAI). Dan key trong app hoac o day.
# DEEPSEEK_API_KEY=
# DEEPSEEK_TRANSLATE_MODEL=deepseek-flash
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# Qwen / DashScope dich (qwen3.7-flash). Key quoc te → intl; key Trung → CN base.
# QWEN_API_KEY=
# DASHSCOPE_API_KEY=
# QWEN_TRANSLATE_MODEL=qwen3.7-flash
# QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
# QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
